# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4004/api
# Server-side Next -> Nest URL. This does not need to be public.
API_INTERNAL_URL=http://127.0.0.1:4004/api

# API
PORT=4004
WEB_PORT=4204
# Lista exata de origens permitidas pelo CORS e pela proteção anti-CSRF.
# Esta variável pode restringir a allowlist fixa da aplicação, mas não ampliá-la.
# Origens máximas aceitas:
#   http://localhost:4204
#   http://192.168.199.234
#   http://192.168.199.234:4204
#   https://helpdesk.nivel3ti.com.br
WEB_ORIGIN=http://localhost:4204,http://192.168.199.234,http://192.168.199.234:4204,https://helpdesk.nivel3ti.com.br
WEB_PUBLIC_URL=https://helpdesk.nivel3ti.com.br
SWAGGER_ENABLED=true

# Native API session
API_SESSION_COOKIE=HELPDESK_SESSION
API_SESSION_TTL_DAYS=30
# false for local HTTP. Use true when the browser accesses the app over HTTPS.
SESSION_COOKIE_SECURE=false

# SMTP compartilhado pela recuperação de senha e pelas notificações de atendimentos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=troque-esta-senha
SMTP_FROM=Helpdesk <usuario@example.com>

# Notificações transacionais de atendimento.
# Deixe false até validar SMTP em homologação/produção. Os eventos continuam
# sendo gravados na outbox enquanto o envio estiver desabilitado.
TICKET_NOTIFICATION_EMAIL_ENABLED=false
TICKET_NOTIFICATION_EMAIL_INTERVAL_MS=30000
TICKET_NOTIFICATION_EMAIL_BATCH_SIZE=50

# Ticket automation worker
# These jobs replace the automatic jobs previously executed by atd/home.php.
TICKET_HOLD_AUTO_RESUME_ENABLED=true
TICKET_HOLD_AUTO_RESUME_INTERVAL_MS=60000
TICKET_HOLD_AUTO_RESUME_BATCH_SIZE=100
TICKET_SCHEDULED_ACTIVATION_ENABLED=true
TICKET_SCHEDULED_ACTIVATION_INTERVAL_MS=60000
TICKET_SCHEDULED_ACTIVATION_BATCH_SIZE=100
TICKET_RECURRENCE_ENABLED=true
TICKET_RECURRENCE_INTERVAL_MS=60000
TICKET_RECURRENCE_BATCH_SIZE=100

# Transitional legacy PHP session bridge.
# legacy/bridge/session.php reads both values; relative paths are resolved from
# the repository root. Keep these only while authenticated PHP remains.
LEGACY_SESSION_COOKIE=PHPSESSID
LEGACY_SESSION_PATH=./storage/sessions

# Banco SQL Server ativo da aplicação.
# A porta da instância nomeada pode mudar caso esteja configurada como dinâmica.
NIVEL3_DATABASE_URL=sqlserver://127.0.0.1:55523;database=nivel3_hml
NIVEL3_SQLSERVER_HOST=127.0.0.1
NIVEL3_SQLSERVER_PORT=55523
NIVEL3_SQLSERVER_USER=nivel3_app
NIVEL3_SQLSERVER_PASSWORD=change-me
DB_CONNECTION_LIMIT=5
DB_REQUEST_TIMEOUT_MS=60000

# MySQL/MariaDB legado (somente para migração ou consumidores antigos).
# Keep Docker on 3307 so it can coexist with XAMPP/MySQL on 3306.
# DB_PORT=3307
# DB_ROOT_PASSWORD=change-me

# Temporary generated report storage.
# Production should preferably use a path outside the application checkout.
# Defaults locally to <workspace>/storage/reports.
# REPORT_STORAGE_DIR=/var/lib/helpdesk/reports
#
# Windows example:
# REPORT_STORAGE_DIR=C:/ProgramData/Helpdesk/reports
#
# Generated reports are temporary and expire after this many days.
REPORT_RETENTION_DAYS=15
# Cleanup is executed by the dedicated worker.
REPORT_CLEANUP_ENABLED=true
REPORT_CLEANUP_INTERVAL_MS=86400000

# Ticket attachment storage.
# Keep this outside the application checkout in production.
# Defaults locally to <workspace>/storage/uploads/tickets.
# Files still present in <workspace>/uploads remain readable during migration.
# TICKET_UPLOAD_DIR=/var/lib/helpdesk/ticket-attachments
#
# Catalog image storage.
# Defaults locally to <workspace>/storage/uploads/catalog.
# In production, prefer a persistent path outside the application checkout.
# CATALOG_UPLOAD_DIR=/var/lib/helpdesk/catalog-images
#
# Logistics expense attachment storage.
# Keep this outside the application checkout in production.
# Defaults locally to <workspace>/storage/uploads/rd.
# Files still present in <workspace>/uploads_rd remain readable during migration.
# RD_UPLOAD_DIR=/var/lib/helpdesk/logistics/expense-attachments

# Deprecated compatibility only. The native architecture has no separate mkt DB.
# Define this only while a still-legacy PHP consumer explicitly calls ConnectionMkt().
# MKT_DATABASE_URL=mysql://root@127.0.0.1:3306/mkt

# Produção:
# aponte as variáveis NIVEL3_SQLSERVER_* para o host e a porta do SQL Server.
# Mantenha a senha fora do controle de versão.

# Administração -> Manutenção
# Armazenamento de backups e dumps validados. Em produção, use um caminho
# persistente fora do checkout da aplicação.
# MAINTENANCE_STORAGE_DIR=/var/lib/helpdesk/maintenance
#
# Caminhos opcionais para os binários nativos. Se omitidos, a API procura
# mariadb-dump/mysqldump e mariadb/mysql no PATH.
# MARIADB_DUMP_BIN=/usr/bin/mariadb-dump
# MARIADB_CLIENT_BIN=/usr/bin/mariadb
#
# Tamanho máximo aceito para importação de dump SQL.
MAINTENANCE_DUMP_MAX_MB=1024
#
# O worker consulta jobs persistidos no nivel3 e mantém heartbeat para a tela.
MAINTENANCE_BACKUP_WORKER_ENABLED=true
MAINTENANCE_BACKUP_WORKER_INTERVAL_MS=30000


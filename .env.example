# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4004/api
# Server-side Next -> Nest URL. This does not need to be public.
API_INTERNAL_URL=http://127.0.0.1:4004/api

# API
PORT=4004
WEB_PORT=4204
WEB_ORIGIN=http://localhost:4204
WEB_PUBLIC_URL=http://localhost:4204
SWAGGER_ENABLED=true

# Native API session
API_SESSION_COOKIE=HELPDESK_SESSION
API_SESSION_TTL_DAYS=30
# false for local HTTP. Use true when the browser accesses the app over HTTPS.
SESSION_COOKIE_SECURE=false

# SMTP compartilhado pela recuperação de senha e pelas notificações de atendimentos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=troque-esta-senha
SMTP_FROM=Helpdesk <usuario@example.com>

# Notificações transacionais de atendimento.
# Deixe false até validar SMTP em homologação/produção. Os eventos continuam
# sendo gravados na outbox enquanto o envio estiver desabilitado.
TICKET_NOTIFICATION_EMAIL_ENABLED=false
TICKET_NOTIFICATION_EMAIL_INTERVAL_MS=30000
TICKET_NOTIFICATION_EMAIL_BATCH_SIZE=50

# Ticket automation worker
# These jobs replace the automatic jobs previously executed by atd/home.php.
TICKET_HOLD_AUTO_RESUME_ENABLED=true
TICKET_HOLD_AUTO_RESUME_INTERVAL_MS=60000
TICKET_HOLD_AUTO_RESUME_BATCH_SIZE=100
TICKET_SCHEDULED_ACTIVATION_ENABLED=true
TICKET_SCHEDULED_ACTIVATION_INTERVAL_MS=60000
TICKET_SCHEDULED_ACTIVATION_BATCH_SIZE=100
TICKET_RECURRENCE_ENABLED=true
TICKET_RECURRENCE_INTERVAL_MS=60000
TICKET_RECURRENCE_BATCH_SIZE=100

# Transitional legacy PHP session bridge.
# legacy/bridge/session.php reads both values; relative paths are resolved from
# the repository root. Keep these only while authenticated PHP remains.
LEGACY_SESSION_COOKIE=PHPSESSID
LEGACY_SESSION_PATH=./storage/sessions

# Docker local database
# Keep Docker on 3307 so it can coexist with XAMPP/MySQL on 3306.
DB_PORT=3307
DB_ROOT_PASSWORD=helpdesk

# Local URLs (host -> Docker database)
# Shared by Prisma/Nest and by the residual legacy PHP bridge in all/conect.php.
NIVEL3_DATABASE_URL=mysql://root:helpdesk@127.0.0.1:3307/nivel3
N3RD_DATABASE_URL=mysql://root:helpdesk@127.0.0.1:3307/n3rd

# Deprecated compatibility only. The native architecture has no separate mkt DB.
# Define this only while a still-legacy PHP consumer explicitly calls ConnectionMkt().
# MKT_DATABASE_URL=mysql://root@127.0.0.1:3306/mkt

# Production/XAMPP:
# point the same variables to the server MySQL/MariaDB host instead.
# Example without a root password:
# NIVEL3_DATABASE_URL=mysql://root@127.0.0.1:3306/nivel3
# N3RD_DATABASE_URL=mysql://root@127.0.0.1:3306/n3rd

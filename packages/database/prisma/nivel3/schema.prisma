  ag_nome String @db.NVarChar(100)
  status  Int?   @default(1, map: "DF__agenciasb__statu__67DE6983")
}

model agenda_veiculos {
  id                  Int       @id(map: "PK_agenda_veiculos_id") @default(autoincrement())
  veiculo_id          Int
  data                DateTime  @db.Date
  empresa             String    @db.NVarChar(100)
  cidade              String?   @db.NVarChar(100)
  horario             String    @db.NVarChar(20)
  motorista           Int
  observacoes         String?   @db.NVarChar(Max)
  color               Int?      @default(1, map: "DF__agenda_ve__color__6ABAD62E")
  kmInicial           Int?
  kmFinal             Int?
  visibilidade        Int       @default(0, map: "DF__agenda_ve__visib__6D9742D9")
  usuario_id          Int
  criado_em           DateTime? @default(now(), map: "DF__agenda_ve__criad__6E8B6712")
  arquivado           Int?      @default(0, map: "DF__agenda_ve__arqui__6F7F8B4B") @db.SmallInt
  data_anterior       DateTime? @db.Date
  horario_anterior    DateTime? @db.Time
  veiculo_id_anterior Int?
  ultima_alteracao    DateTime? @db.DateTime
  modificado_por_id   Int?
  veiculos            veiculos  @relation(fields: [veiculo_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agenda_veiculos$agenda_veiculos_ibfk_1")

  @@index([veiculo_id], map: "veiculo_id")
}

model api_idempotency_keys {
  id              BigInt    @id(map: "PK_api_idempotency_keys") @default(autoincrement())
  user_id         Int
  idempotency_key String    @db.VarChar(128)
  request_method  String    @db.VarChar(10)
  request_path    String    @db.VarChar(500)
  request_hash    String    @db.Char(64)
  response_status Int?
  response_body   String?   @db.VarChar(Max)
  locked_until    DateTime?
  created_at      DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_api_idempotency_keys_created_at")
  expires_at      DateTime
  usuarios        usuarios  @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "FK_api_idempotency_keys_user")

  @@unique([user_id, idempotency_key], map: "UQ_api_idempotency_keys_user_key")
  @@index([expires_at], map: "IX_api_idempotency_keys_expires_at")
}

model api_outbox_events {
  id              String    @id(map: "PK_api_outbox_events") @db.Char(36)
  idempotency_key String    @unique(map: "UQ_api_outbox_events_idempotency_key") @db.VarChar(190)
  aggregate_type  String    @db.VarChar(80)
  aggregate_id    String    @db.VarChar(80)
  event_type      String    @db.VarChar(120)
  payload         String    @db.VarChar(Max)
  attempts        Int       @default(0, map: "DF_api_outbox_events_attempts")
  available_at    DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_api_outbox_events_available_at")
  claimed_at      DateTime?
  processed_at    DateTime?
  last_error      String?   @db.VarChar(1000)
  created_at      DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_api_outbox_events_created_at")

  @@index([processed_at, available_at], map: "IX_api_outbox_events_processed_available")
}

model api_sessions {
  id                 String    @id(map: "PK_api_sessions") @db.Char(36)
  family_id          String    @db.Char(36)
  user_id            Int
  refresh_token_hash String    @unique(map: "UQ_api_sessions_refresh_token_hash") @db.Char(64)
  replaced_by_id     String?   @db.Char(36)
  device_name        String?   @db.VarChar(160)
  user_agent         String?   @db.VarChar(500)
  ip_address         String?   @db.VarChar(45)
  created_at         DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_api_sessions_created_at")
  last_used_at       DateTime?
  expires_at         DateTime
  revoked_at         DateTime?
  revoke_reason      String?   @db.VarChar(120)

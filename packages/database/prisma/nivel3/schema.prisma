generator client {
  provider = "prisma-client"
  output   = "../../generated/nivel3"
}

datasource db {
  provider = "mysql"
}

model agenciasbancarias {
  id      Int    @id
  ag_nome String @db.VarChar(100)
  status  Int?   @default(1)
}

model agenda_veiculos {
  id                  Int       @id @default(autoincrement())
  veiculo_id          Int
  data                DateTime  @db.Date
  empresa             String    @db.VarChar(100)
  cidade              String?   @db.VarChar(100)
  horario             String    @db.VarChar(20)
  motorista           Int
  observacoes         String?   @db.Text
  color               Int?      @default(1)
  kmInicial           Int?
  kmFinal             Int?
  visibilidade        Int       @default(0)
  usuario_id          Int
  criado_em           DateTime? @default(now()) @db.DateTime(0)
  arquivado           Boolean?  @default(false)
  data_anterior       DateTime? @db.Date
  horario_anterior    DateTime? @db.Time(0)
  veiculo_id_anterior Int?
  ultima_alteracao    DateTime? @db.Timestamp(0)
  modificado_por_id   Int?
  veiculos            veiculos  @relation(fields: [veiculo_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "agenda_veiculos_ibfk_1")

  @@index([veiculo_id], map: "veiculo_id")
}

model api_idempotency_keys {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         Int
  idempotency_key String    @db.VarChar(128)
  request_method  String    @db.VarChar(10)
  request_path    String    @db.VarChar(500)
  request_hash    String    @db.Char(64)
  response_status Int?      @db.UnsignedSmallInt
  response_body   String?   @db.LongText
  locked_until    DateTime? @db.DateTime(6)
  created_at      DateTime  @default(now()) @db.DateTime(6)
  expires_at      DateTime  @db.DateTime(6)
  usuarios        usuarios  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_api_idempotency_user")

  @@unique([user_id, idempotency_key], map: "uq_api_idempotency_user_key")
  @@index([expires_at], map: "ix_api_idempotency_expiry")
}

model api_outbox_events {
  id              String    @id @db.Char(36)
  idempotency_key String    @unique(map: "uq_api_outbox_idempotency") @db.VarChar(190)
  aggregate_type  String    @db.VarChar(80)
  aggregate_id    String    @db.VarChar(80)
  event_type      String    @db.VarChar(120)
  payload         String    @db.LongText
  attempts        Int       @default(0) @db.UnsignedSmallInt
  available_at    DateTime  @default(now()) @db.DateTime(6)
  claimed_at      DateTime? @db.DateTime(6)
  processed_at    DateTime? @db.DateTime(6)
  last_error      String?   @db.VarChar(1000)
  created_at      DateTime  @default(now()) @db.DateTime(6)

  @@index([processed_at, available_at], map: "ix_api_outbox_pending")
}

model api_sessions {
  id                 String    @id @db.Char(36)
  family_id          String    @db.Char(36)
  user_id            Int
  refresh_token_hash String    @unique(map: "uq_api_sessions_token_hash") @db.Char(64)
  replaced_by_id     String?   @db.Char(36)
  device_name        String?   @db.VarChar(160)
  user_agent         String?   @db.VarChar(500)
  ip_address         String?   @db.VarChar(45)
  created_at         DateTime  @default(now()) @db.DateTime(6)
  last_used_at       DateTime? @db.DateTime(6)
  expires_at         DateTime  @db.DateTime(6)
  revoked_at         DateTime? @db.DateTime(6)
  revoke_reason      String?   @db.VarChar(120)
  usuarios           usuarios  @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_api_sessions_user")

  @@index([family_id], map: "ix_api_sessions_family")
  @@index([user_id, revoked_at, expires_at], map: "ix_api_sessions_user_active")
}

model atendimento_recorrencias {
  id                    Int                                      @id @default(autoincrement()) @db.UnsignedInt
  atendimento_modelo_id Int                                      @unique(map: "uq_atendimento_recorrencias_modelo")
  nome                  String                                   @db.VarChar(180)
  cliente_id            Int
  periodo               Int                                      @db.UnsignedTinyInt
  proxima_reabertura    DateTime                                 @db.DateTime(0)
  quantidade_modo       atendimento_recorrencias_quantidade_modo @default(fixa)
  quantidade_total      Int?                                     @db.UnsignedSmallInt
  quantidade_restante   Int                                      @default(1) @db.UnsignedSmallInt
  ativo                 Boolean                                  @default(true)
  criado_por            Int?
  atualizado_por        Int?
  criado_em             DateTime                                 @default(now()) @db.DateTime(0)
  atualizado_em         DateTime                                 @default(now()) @db.DateTime(0)

  @@index([ativo, proxima_reabertura], map: "idx_atendimento_recorrencias_execucao")
  @@index([cliente_id, periodo, ativo], map: "idx_atendimento_recorrencias_filtros")
}


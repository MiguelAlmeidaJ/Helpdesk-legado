generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/nivel3"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "sqlserver"
}

model access_migrations {
  migration_key String   @id(map: "PK_access_migrations_migration_key") @db.NVarChar(120)
  applied_at    DateTime @default(now(), map: "DF__access_mi__appli__66EA454A")
}

model agenciasbancarias {

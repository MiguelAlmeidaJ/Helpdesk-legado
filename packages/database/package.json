{
  "name": "@helpdesk/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:pull": "pnpm db:pull:nivel3 && pnpm db:pull:n3rd",
    "db:pull:nivel3": "prisma db pull --config=prisma/nivel3/prisma.config.ts",
    "db:pull:n3rd": "prisma db pull --config=prisma/n3rd/prisma.config.ts",
    "db:generate": "pnpm db:generate:nivel3 && pnpm db:generate:n3rd",
    "db:generate:nivel3": "prisma generate --config=prisma/nivel3/prisma.config.ts",
    "db:generate:n3rd": "prisma generate --config=prisma/n3rd/prisma.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "7.10.0",
    "typescript": "^5.9.0"
  }
}

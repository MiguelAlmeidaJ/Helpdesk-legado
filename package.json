{
  "name": "helpdesk-monorepo",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:pull": "pnpm --filter @helpdesk/database db:pull",
    "db:generate": "pnpm --filter @helpdesk/database db:generate",
    "access:audit": "pnpm --filter @helpdesk/database access:audit",
    "access:bootstrap": "pnpm --filter @helpdesk/database access:bootstrap",
    "access:grant-system-admin": "pnpm --filter @helpdesk/database access:grant-system-admin",
    "access:provision-global-admin": "node scripts/provision-global-admin.cjs",
    "test:global-admin": "node --test scripts/global-admin.test.cjs",
    "test:cnpj": "node --test scripts/cnpj.test.cjs",
    "test:cnpj:ui": "node scripts/cnpj-ui-smoke.cjs",
    "navigation:bootstrap": "pnpm --filter @helpdesk/database navigation:bootstrap",
    "users:bootstrap": "pnpm --filter @helpdesk/database users:bootstrap",
    "clients:bootstrap": "node scripts/provision-client-email-preferences.cjs",
    "test:client-emails": "node --test scripts/client-email-preferences.test.cjs",
    "tickets:bootstrap": "pnpm --filter @helpdesk/database tickets:bootstrap",
    "notifications:bootstrap": "pnpm --filter @helpdesk/database notifications:bootstrap",
    "sla:bootstrap": "pnpm --filter @helpdesk/database sla:bootstrap",
    "oncall:bootstrap": "pnpm --filter @helpdesk/database oncall:bootstrap",
    "holidays:bootstrap": "node scripts/provision-regional-holidays.cjs",
    "test:holidays": "node --test scripts/quality-calendar.test.cjs",
    "test:holidays:ui": "node scripts/quality-calendar-ui-smoke.cjs",
    "legacy:audit": "node scripts/audit-legacy-php.mjs",
    "legacy:assets:audit": "node scripts/audit-assets-legacy.mjs",
    "legacy:assets:verify": "pnpm legacy:assets:audit && pnpm legacy:audit && pnpm typecheck && pnpm build",
    "legacy:catalog:audit": "node scripts/audit-catalog-legacy.mjs --strict",
    "legacy:catalog:verify": "pnpm legacy:catalog:audit && pnpm legacy:audit && pnpm typecheck && pnpm build",
    "test:reports": "node --test scripts/reports.test.cjs",
    "test:reports:archive:ui": "node scripts/report-archive-ui-smoke.cjs",
    "test:reports:charts:ui": "node scripts/report-charts-ui-smoke.cjs",
    "test:reports:sectors": "node --test scripts/report-sector.test.cjs",
    "test:reports:daily": "node --test scripts/report-daily.test.cjs",
    "test:reports:center": "node --test scripts/report-center.test.cjs scripts/report-projects.test.cjs",
    "test:reports:center:ui": "node scripts/report-center-ui-smoke.cjs",
    "test:reports:sectors:ui": "node scripts/report-sectors-ui-smoke.cjs",
    "test:reports:clients": "node --test scripts/report-technical-clients.test.cjs",
    "test:navigation": "node --test scripts/navigation.test.cjs",
    "test:notifications": "node --test scripts/notifications.test.cjs",
    "test:access": "node --test scripts/access-rbac.test.cjs",
    "test:security": "node --test scripts/security.test.cjs",
    "test:backups": "node --test scripts/backup-native.test.cjs",
    "test:media": "node --test scripts/media-storage.test.cjs scripts/media-access.test.cjs",
    "test:media:sql": "node --test scripts/media-sqlserver.test.cjs",
    "media:provision": "node scripts/provision-media.cjs",
    "media:migrate": "node scripts/media-migrate.cjs",
    "backup:native:verify": "node scripts/backup-native-smoke.cjs",
    "test:reports:db": "node scripts/reports-db-smoke.cjs",
    "test:logistics": "node --test scripts/logistics.test.cjs scripts/logistics-status.test.cjs",
    "storage:migrate": "node scripts/migrate-runtime-uploads.mjs",
    "docker:up": "docker compose up -d database",
    "docker:down": "docker compose down --remove-orphans",
    "docker:reset": "docker compose down -v --remove-orphans",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "prod:bootstrap": "pnpm access:bootstrap && pnpm navigation:bootstrap && pnpm users:bootstrap && pnpm clients:bootstrap && pnpm tickets:bootstrap && pnpm notifications:bootstrap && pnpm sla:bootstrap && pnpm oncall:bootstrap && pnpm holidays:bootstrap",
    "prod:verify": "pnpm legacy:audit && pnpm legacy:assets:audit && pnpm legacy:catalog:audit && pnpm typecheck && pnpm build && pnpm test:access && pnpm test:navigation && pnpm test:notifications && pnpm test:security && pnpm test:reports && pnpm test:logistics",
    "test:user-functions": "node --test scripts/user-functions.test.cjs",
    "test:user-functions:ui": "node scripts/user-functions-ui-smoke.cjs"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "^5.9.0"
  }
}
